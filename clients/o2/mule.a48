; mule.a48 -- M.U.L.E. for the Magnavox Odyssey 2 / Philips Videopac, over
; FujiNet. A protocol 2 (APPBANK) image: the fixed half (src/fixed.inc) and
; NPAGES pages, one assembly per page; build.sh sets PAGE.

    cpu 8048
    include "g7000.h"
    include "equ.inc"
    include "proto.inc"
    include "strid.inc"
    include "ram.inc"
    include "page.inc"
    include "fixed.inc"

    if PAGE=0
    include "p0.inc"
    elseif PAGE=1
    include "p1.inc"
    elseif PAGE=2
    include "p2.inc"
    elseif PAGE=3
    include "p3.inc"
    elseif PAGE=4
    include "p4.inc"
    elseif PAGE=5
STRBANK equ 0
    include "pstr.inc"
    elseif PAGE=6
    include "p6.inc"
    elseif PAGE=7
    include "p7.inc"
    elseif PAGE=8
    include "p8.inc"
    elseif PAGE=9
STRBANK equ 1
    include "pstr.inc"
    elseif PAGE=10
    include "p10.inc"
    elseif PAGE=11
    include "p11.inc"
    elseif PAGE=12
    include "p12.inc"
    elseif PAGE=13
    include "p13.inc"
    elseif PAGE=14
STRBANK equ 2
    include "pstr.inc"
    endif
