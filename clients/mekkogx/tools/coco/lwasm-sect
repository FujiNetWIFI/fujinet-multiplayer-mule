#!/bin/sh
# lwasm-sect -- lwasm for CMOC (--lwasm=), moving a module's code and
# read-only data into another section.
#
# CMOC has no section pragma, so the Makefile exports MULE_SECT for the
# modules that go elsewhere (see src/coco/mule.link):
#   hi         code -> hicode, rodata -> hirodata ($8000-$BFFF)
#   ov1..ov5   code and rodata -> ovN (the overlay window)
# rwdata, bss and initgl are left alone: they must stay in low RAM.
if [ -n "$MULE_SECT" ]; then
  for a in "$@"; do
    case "$a" in
      *.s|*.asm)
        case "$MULE_SECT" in
          hi)  sed -i -e 's/^\([ \t]*SECTION[ \t]*\)code\b/\1hicode/' \
                      -e 's/^\([ \t]*SECTION[ \t]*\)rodata\b/\1hirodata/' "$a" ;;
          *)   sed -i -e "s/^\([ \t]*SECTION[ \t]*\)\(code\|rodata\)\b/\1$MULE_SECT/" "$a" ;;
        esac ;;
    esac
  done
fi
exec lwasm "$@"
